# Caminho absoluto ou relativo para o banco SQLite da API.
# O padrão é backend/data/dash-vps.db.
DASH_VPS_DATABASE_PATH=data/dash-vps.db

# Gere um valor longo e aleatório para autorizar a ingestão. Não versione o valor real.
# Exemplo de geração: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASH_VPS_INGEST_TOKEN=substitua-por-um-token-longo-e-aleatorio
